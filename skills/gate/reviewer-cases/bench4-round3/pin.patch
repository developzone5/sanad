+// UserViewBar — the role chip in an admin's view-as strip.
+// The strip and the top bar show the same person's role on one screen. The strip used a second word
+// list (tickets.role*) with no Applicant word, so the two could disagree. Both now use getRoleLabel.
+// Real EN/AR bundles; the view-as lib is mocked.
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { act, render, screen } from '@testing-library/react';
+
+vi.mock('@/lib/user-view', () => ({ endUserView: vi.fn() }));
+
+const { i18nReady, switchLanguage } = await import('@/i18n');
+const { default: useAuthStore } = await import('@/stores/auth-store');
+const { default: useUserViewStore } = await import('@/stores/user-view-store');
+const { default: UserViewBar } = await import('./UserViewBar');
+
+const ARABIC: Record<string, string> = {
+  Teacher: 'معلم',
+  Student: 'طالب',
+  Parent: 'ولي أمر',
+  Manager: 'مدير',
+  Applicant: 'متقدم',
+};
+
+async function setPageLanguage(lang: 'en' | 'ar') {
+  await act(async () => {
+    await switchLanguage(lang);
+  });
+}
+
+function viewAs(role: string) {
+  useAuthStore.setState({ user: { id: 9, fullName: 'Viewed Member', email: 'member@example.test', roles: [role] } as never });
+  useUserViewStore.setState({
+    session: {
+      sessionId: 1,
+      handle: 'h',
+      expiresAt: new Date(Date.now() + 30 * 60 * 1000).toISOString(),
+      target: { id: 9, fullName: 'Viewed Member', roles: [role] },
+      ticket: { id: 5, number: 'TKT-1-1' },
+    },
+  });
+}
+
+beforeAll(async () => {
+  await i18nReady;
+});
+afterEach(async () => {
+  useUserViewStore.setState({ session: null });
+  await setPageLanguage('en');
+});
+
+describe('UserViewBar — role chip uses the same words as the top bar', () => {
+  // Review note 3 (owner: "Yes, same words"): the strip shows the role with the top bar's words.
+  it.each(Object.keys(ARABIC))('[C7] shows the top bar word for %s on an Arabic page', async (role) => {
+    await setPageLanguage('ar');
+    viewAs(role);
+    const { container } = render(<UserViewBar />);
+    expect(container.querySelector('.uv-bar-role')?.textContent).toBe(ARABIC[role]);
+  });
+
+  it('[C7] shows the English word on an English page', async () => {
+    await setPageLanguage('en');
+    viewAs('Applicant');
+    render(<UserViewBar />);
+    expect(screen.getByText('Applicant').className).toContain('uv-bar-role');
+  });
+});
