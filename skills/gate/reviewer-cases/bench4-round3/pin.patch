index 00000000000..ddc2623f2d7
--- /dev/null
+++ b/eduquest-frontend/src/components/layout/Topbar.role-label.test.tsx
@@ -0,0 +1,180 @@
+// Topbar — the role line under the user's name.
+// It printed the raw role name ("Teacher", "Admin", ...) in every language, so an Arabic page showed
+// one English line in an Arabic top bar. It now shows the role word in the page's language.
+// Real query client and real EN/AR bundles; the API modules are mocked.
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { MemoryRouter } from 'react-router-dom';
+
+vi.mock('@/api/auth', () => ({ authApi: { logout: vi.fn() } }));
+vi.mock('@/api/communications', () => ({
+  communicationsApi: { getUnreadCount: vi.fn().mockResolvedValue({ unreadCount: 0 }), getFeed: vi.fn().mockResolvedValue({ items: [] }) },
+}));
+vi.mock('@/api/notifications', () => ({
+  notificationsApi: { getUnreadCount: vi.fn().mockResolvedValue({ unreadCount: 0 }), getAll: vi.fn().mockResolvedValue({ items: [] }), markRead: vi.fn() },
+}));
+vi.mock('@/lib/unsaved-changes', () => ({ confirmDiscardUnsavedChanges: vi.fn().mockResolvedValue(true) }));
+
+const { i18nReady, switchLanguage } = await import('@/i18n');
+const { default: useAuthStore } = await import('@/stores/auth-store');
+const { default: useUIStore } = await import('@/stores/ui-store');
+const { default: Topbar } = await import('./Topbar');
+
+// The words each bundle holds for the roles (users.enums.roles), written out so a test fails
+// if the top bar shows the raw role name instead.
+const ARABIC: Record<string, string> = {
+  Teacher: 'معلم',
+  Student: 'طالب',
+  Parent: 'ولي أمر',
+  Manager: 'مدير',
+  Admin: 'مسؤول النظام',
+  Applicant: 'متقدم',
+};
+const ENGLISH: Record<string, string> = {
+  Teacher: 'Teacher',
+  Student: 'Student',
+  Parent: 'Parent',
+  Manager: 'Manager',
+  Admin: 'Admin',
+  Applicant: 'Applicant',
+};
+
+function renderTopbar() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter>
+        <Topbar />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+async function setPageLanguage(lang: 'en' | 'ar') {
+  await act(async () => {
+    useUIStore.setState({ language: lang });
+    await switchLanguage(lang);
+  });
+}
+
+function signInAs(roles: string[], fullName = 'Demo Person') {
+  useAuthStore.setState({ user: { id: 3, fullName, email: 'person@example.test', roles } as never });
+}
+
+/** The role line: the paragraph under the name inside the profile block. */
+function roleLine(): string {
+  const block = screen.getByRole('button', { name: /Demo Person/ });
+  return (block.querySelector('p')?.textContent ?? '').trim();
+}
+
+beforeAll(async () => {
+  await i18nReady;
+});
+afterEach(async () => {
+  await setPageLanguage('en');
+});
+
+describe('Topbar — role line in the page language', () => {
+  // T1: "When I use the site in Arabic, the role under my name in the top bar shows in English:
+  // "Teacher", "Student", "Parent", "Manager" or "Admin"."
+  it.each(['Teacher', 'Student', 'Parent', 'Manager', 'Admin'])('[C1] shows the Arabic word for %s on an Arabic page', async (role) => {
+    await setPageLanguage('ar');
+    signInAs([role]);
+    renderTopbar();
+    expect(roleLine()).toBe(ARABIC[role]);
+    expect(roleLine()).not.toContain(role);
+  });
+
+  // T3: "The role must show in the page's language, for every role, and stay right when the language is switched."
+  it.each(Object.keys(ENGLISH))('[C2] shows %s in the page language, Arabic and English', async (role) => {
+    await setPageLanguage('ar');
+    signInAs([role]);
+    const { unmount } = renderTopbar();
+    expect(roleLine()).toBe(ARABIC[role]);
+    unmount();
+
+    await setPageLanguage('en');
+    renderTopbar();
+    expect(roleLine()).toBe(ENGLISH[role]);
+  });
+
+  // T3: "The role must show in the page's language, for every role, and stay right when the language is switched."
+  it('[C3] changes the role line at once when the language is switched, both ways', async () => {
+    await setPageLanguage('en');
+    signInAs(['Teacher']);
+    renderTopbar();
+    expect(roleLine()).toBe('Teacher');
+
+    // The real switcher in the top bar: the "ع" button, then "EN".
+    fireEvent.click(screen.getByRole('button', { name: 'ع' }));
+    await waitFor(() => expect(roleLine()).toBe('معلم'), { timeout: 2000 });
+
+    fireEvent.click(screen.getByRole('button', { name: 'EN' }));
+    await waitFor(() => expect(roleLine()).toBe('Teacher'), { timeout: 2000 });
+  });
+
+  // Change: a user can come with an empty role list, or with a role the bundles do not know.
+  it('[C4] shows a word in the page language when the user has no role, and the raw name for an unknown role', async () => {
+    await setPageLanguage('ar');
+    signInAs([]);
+    const second = renderTopbar();
+    expect(roleLine()).toBe('مستخدم');
+    second.unmount();
+
+    signInAs(['Auditor']);
+    const third = renderTopbar();
+    expect(roleLine()).toBe('Auditor');
+    third.unmount();
+
+    await setPageLanguage('en');
+    signInAs([]);
+    renderTopbar();
+    expect(roleLine()).toBe('User');
+  });
+
+  // Change: the same "User" word is the name when a saved session has no name; the avatar letter
+  // comes from that name, so it must not stay a hard-coded English "U" on an Arabic page.
+  it('[C5] uses the page-language word for the name and the avatar letter when there is no name', async () => {
+    await setPageLanguage('ar');
+    signInAs(['Teacher'], '');
+    const arabic = renderTopbar();
+    const arBlock = screen.getByRole('button', { name: /معلم/ });
+    expect(arBlock.querySelector('.flex-grow-1 > span')?.textContent).toBe('مستخدم');
+    expect(arBlock.querySelector('.b-r-10')?.textContent).toBe('م');
+    arabic.unmount();
+
+    await setPageLanguage('en');
+    renderTopbar();
+    const enBlock = screen.getByRole('button', { name: /Teacher/ });
+    expect(enBlock.querySelector('.flex-grow-1 > span')?.textContent).toBe('User');
+    expect(enBlock.querySelector('.b-r-10')?.textContent).toBe('U');
+  });
+
+  // Review note 5: a name of only spaces is no name; it must get the generic word, not a blank.
+  it('[C5] treats a name of only spaces as no name, in Arabic and English', async () => {
+    await setPageLanguage('ar');
+    signInAs(['Teacher'], '   ');
+    const arabic = renderTopbar();
+    const arBlock = screen.getByRole('button', { name: /معلم/ });
+    expect(arBlock.querySelector('.flex-grow-1 > span')?.textContent).toBe('مستخدم');
+    expect(arBlock.querySelector('.b-r-10')?.textContent).toBe('م');
+    arabic.unmount();
+
+    await setPageLanguage('en');
+    renderTopbar();
+    const enBlock = screen.getByRole('button', { name: /Teacher/ });
+    expect(enBlock.querySelector('.flex-grow-1 > span')?.textContent).toBe('User');
+  });
+
+  // T2: "Every other word of the top bar is in Arabic, so this line looks broken to our users."
+  it.each(Object.keys(ARABIC))('[C6] leaves no English word in the Arabic profile block for %s', async (role) => {
+    await setPageLanguage('ar');
+    signInAs([role], 'أحمد علي');
+    renderTopbar();
+    const block = screen.getByRole('button', { name: /أحمد علي/ });
+    const profile = block.closest('li') as HTMLElement;
+    expect(profile.textContent).not.toMatch(/[A-Za-z]/);
+    expect(profile.textContent).toContain(ARABIC[role]);
+  });
+});
