@@ -0,0 +1,22 @@
+import { act, render, screen } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import i18n from '@/i18n';
+import { HomeworkCard } from './HomeworkCard';
+
+describe('HomeworkCard due label', () => {
+  // SCH-466: "It must show the word in the page's language, and change at once when the language is switched."
+  it('shows the due word in Arabic on an Arabic page and in English after a switch', async () => {
+    await act(() => i18n.changeLanguage('ar'));
+    render(<HomeworkCard title="مقال" dueAt="2026-12-01T09:00:00Z" />);
+    expect(screen.getByText(/موعد التسليم:/)).toBeInTheDocument();
+    expect(screen.queryByText(/Due:/)).toBeNull();
+    await act(() => i18n.changeLanguage('en'));
+    expect(screen.getByText(/Due:/)).toBeInTheDocument();
+  });
+
+  it('shows no due line when the homework has no due date', async () => {
+    await act(() => i18n.changeLanguage('en'));
+    render(<HomeworkCard title="Essay" dueAt={null} />);
+    expect(screen.queryByText(/Due:/)).toBeNull();
+  });
+});
