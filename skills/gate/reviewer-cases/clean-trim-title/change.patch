+
+    // SCH-460: "The title is saved and shown as "Essay 2"."
+    [Fact]
+    public async Task Create_saves_the_title_without_spaces_around_it()
+    {
+        var (db, classId, teacherId) = await SeedClassAsync();
+        var id = await new AssignmentService(db).CreateAsync(new CreateAssignmentDto(classId, " Essay 2 ", null), teacherId, default);
+        Assert.Equal("Essay 2", (await db.Assignments.FindAsync(id))!.Title);
+    }
+
+    // SCH-460: "A teacher types " Essay 2 " as an assignment title, on create and on edit."
+    [Fact]
+    public async Task Update_saves_the_title_without_spaces_around_it()
+    {
+        var (db, classId, teacherId) = await SeedClassAsync();
+        var service = new AssignmentService(db);
+        var id = await service.CreateAsync(new CreateAssignmentDto(classId, "Essay", null), teacherId, default);
+        await service.UpdateAsync(id, new UpdateAssignmentDto(" Essay 2 ", null), teacherId, default);
+        Assert.Equal("Essay 2", (await db.Assignments.FindAsync(id))!.Title);
+    }
