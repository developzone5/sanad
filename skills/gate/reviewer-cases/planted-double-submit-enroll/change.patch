--- a/web/src/pages/EnrollPage.tsx
+++ b/web/src/pages/EnrollPage.tsx
@@ -1,16 +1,29 @@
 import { useTranslation } from 'react-i18next';
-import { useQuery } from '@tanstack/react-query';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
 import { coursesApi } from '@/api/courses';
+import { showError, showSuccess } from '@/utils/toast';
 
 export default function EnrollPage({ courseId }: { courseId: number }) {
   const { t } = useTranslation();
+  const queryClient = useQueryClient();
   const { data: course } = useQuery({ queryKey: ['course', courseId], queryFn: () => coursesApi.get(courseId) });
+  const enroll = useMutation({
+    mutationFn: () => coursesApi.enroll(courseId),
+    onSuccess: () => {
+      showSuccess(t('courses.enrolled'));
+      queryClient.invalidateQueries({ queryKey: ['course', courseId] });
+    },
+    onError: (error) => showError(error, 'courses.enrollFailed'),
+  });
 
   if (!course) return null;
   return (
     <section>
       <h1>{course.title}</h1>
       <p>{t('courses.seatsLeft', { count: course.seatsLeft })}</p>
+      <button type="button" onClick={() => enroll.mutate()}>
+        {t('courses.enroll')}
+      </button>
     </section>
   );
 }
