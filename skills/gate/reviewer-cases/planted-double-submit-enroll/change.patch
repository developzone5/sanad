         var taken = await _db.Enrollments.CountAsync(e => e.CourseId == courseId, ct);
         return Math.Max(course.Capacity - taken, 0);
     }
+
+    // SCH-445: one seat for the student, refused when the course is full.
+    public async Task EnrollAsync(int courseId, int studentId, CancellationToken ct)
+    {
+        var already = await _db.Enrollments.AnyAsync(e => e.CourseId == courseId && e.StudentId == studentId, ct);
+        if (already) return;
+        if (await SeatsLeftAsync(courseId, ct) == 0) throw new ConflictException("course.full");
+        _db.Enrollments.Add(new Enrollment { CourseId = courseId, StudentId = studentId, EnrolledAt = DateTime.UtcNow });
+        await _db.SaveChangesAsync(ct);
+    }
 }
