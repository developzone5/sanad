diff --git a/src/Api/Controllers/SubmissionsController.cs b/src/Api/Controllers/SubmissionsController.cs
index 31e602e..364915b 100644
--- a/src/Api/Controllers/SubmissionsController.cs
+++ b/src/Api/Controllers/SubmissionsController.cs
@@ -18,4 +18,13 @@ public class SubmissionsController : ControllerBase
     [Authorize(Roles = "Student")]
     public async Task<IActionResult> Mine([FromQuery] int assignmentId, CancellationToken ct)
         => Ok(await _submissions.ListMineAsync(User.UserId(), assignmentId, ct));
+
+    // SCH-422: one submission with its feedback.
+    [HttpGet("{id:int}")]
+    [Authorize(Roles = "Student")]
+    public async Task<IActionResult> Get(int id, CancellationToken ct)
+    {
+        var submission = await _submissions.GetAsync(id, ct);
+        return submission is null ? NotFound() : Ok(submission);
+    }
 }
