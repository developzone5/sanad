diff --git a/src/Application/Announcements/AnnouncementService.cs b/src/Application/Announcements/AnnouncementService.cs
index 847d41f..4d50574 100644
--- a/src/Application/Announcements/AnnouncementService.cs
+++ b/src/Application/Announcements/AnnouncementService.cs
@@ -11,9 +11,14 @@ public class AnnouncementService
 
     // The newest 20 announcements of the student's school.
     public async Task<IReadOnlyList<AnnouncementDto>> LatestAsync(int schoolId, CancellationToken ct)
+        => await PageAsync(schoolId, 1, ct);
+
+    // One page of 20 announcements of the student's school, newest first. page starts at 1.
+    public async Task<IReadOnlyList<AnnouncementDto>> PageAsync(int schoolId, int page, CancellationToken ct)
         => await _db.Announcements.AsNoTracking()
             .Where(a => a.SchoolId == schoolId && a.PublishedAt != null)
             .OrderByDescending(a => a.PublishedAt).ThenByDescending(a => a.Id)
+            .Skip((Math.Max(page, 1) - 1) * 20)
             .Take(20)
             .Select(a => new AnnouncementDto(a.Id, a.Title, a.PublishedAt!.Value))
             .ToListAsync(ct);
