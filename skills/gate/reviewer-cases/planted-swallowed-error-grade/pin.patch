             .FirstOrDefaultAsync(ct);
+
+    // SCH-452: the teacher of the submission's class stores a grade from 0 to 100.
+    public async Task SaveAsync(int submissionId, int teacherId, decimal grade, CancellationToken ct)
+    {
+        if (grade < 0 || grade > 100) throw new ValidationException("grade.outOfRange");
+        var submission = await _db.Submissions
+            .FirstOrDefaultAsync(s => s.Id == submissionId && s.Assignment.Class.TeacherId == teacherId, ct)
+            ?? throw new NotFoundException("submission.notFound");
+        submission.Grade = grade;
+        await _db.SaveChangesAsync(ct);
+    }
 }
